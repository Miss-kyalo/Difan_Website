# Required for account onboarding emails and initial Boss/HR account provisioning.
SECRET_KEY=replace-with-a-long-random-secret-and-keep-it-stable
SENDGRID_API_KEY=your-sendgrid-api-key
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIN_ACCOUNT_EMAIL=info@difan-logistics.com
# Public origin used in customer tracking links and driver notifications.
PUBLIC_APP_URL=https://your-public-difan-domain.example
# Configure only with an ELD provider that signs the raw webhook body using
# X-Difan-ELD-Signature: sha256=<HMAC-SHA256>. Provider events become disputable HR warnings.
ELD_WEBHOOK_SECRET=

# Signed payroll and legal acknowledgements require an S3 bucket with versioning
# and Object Lock enabled. Use the application's AWS IAM role for credentials.
AWS_REGION=your-aws-region
PAYROLL_DOCUMENTS_BUCKET=your-object-lock-enabled-bucket
PAYROLL_DOCUMENT_KMS_KEY_ID=your-kms-key-id
# Configure this only after HR/legal approves the required retention period.
PAYROLL_DOCUMENT_RETENTION_DAYS=
